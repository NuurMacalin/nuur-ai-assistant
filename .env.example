# Copy this file to app/.env. Keep your real key out of Git.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_REQUEST_TIMEOUT=30

# Local development. Production Compose sets the internal database URL.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sample_collection
QDRANT_API_KEY=
QDRANT_TIMEOUT=10

# Production HTTPS hostname and optional local app port.
SITE_ADDRESS=ai.example.com
APP_PORT=8000
